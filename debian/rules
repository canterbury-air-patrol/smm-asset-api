#!/usr/bin/make -f

# autoreconf runs by default under debhelper compat 13. The old special-case
# for stretch/bionic (no tidy.pc) supported distributions that are now EOL.
%:
	dh $@

# Debian does not ship libtool archives; they cause overlinking.
execute_after_dh_auto_install:
	rm -f debian/tmp/usr/lib/*/libsmmasset.la
